APP_ENV=development
LAB_RUNTIME=mock
ALLOW_MOCK_FALLBACK=false
PUBLIC_HOST=localhost
BACKEND_PUBLIC_URL=http://localhost:8000
DOCKER_WS_HOST=host.docker.internal
# Optional: put Docker build contexts outside the watched backend tree.
BUILD_CONTEXT_DIR=
ADMIN_PASSWORD=linuxai

# AI_MODE can be auto, mock, or deepseek.
AI_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
