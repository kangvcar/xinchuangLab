{
  "experiment_id": "dns-server-configuration",
  "name": "DNS 服务器配置",
  "system": "openEuler",
  "image_name": "linux-ai-exp:dns-server-configuration-v1",
  "status": "published",
  "schema_version": 2,
  "sort_order": 15,
  "objective": "认识 DNS 主配置、区域文件、A 记录和基础解析检查思路。",
  "steps": [
    {
      "id": 1,
      "title": "查看 DNS 主配置",
      "goal": "认识 named.conf 中的区域声明。",
      "instructions": "查看 named.conf.sample。",
      "try_commands": [
        "cat dns/named.conf.sample"
      ],
      "success_criteria": "能看到 zone \"lab.local\"。",
      "coach_focus": "说明 zone 定义域名区域。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "cat dns/named.conf.sample"
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "复制区域文件",
      "goal": "创建可编辑 zone 文件。",
      "instructions": "复制区域文件模板。",
      "try_commands": [
        "cp dns/zones/lab.local.zone.sample dns/zones/lab.local.zone"
      ],
      "success_criteria": "lab.local.zone 存在。",
      "coach_focus": "说明区域文件保存具体解析记录。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "cp dns/zones/lab.local.zone.sample dns/zones/lab.local.zone"
            ]
          },
          {
            "type": "path_exists",
            "path": "dns/zones/lab.local.zone",
            "path_type": "file"
          }
        ]
      }
    },
    {
      "id": 3,
      "title": "查看 NS 记录",
      "goal": "定位权威 DNS 服务器记录。",
      "instructions": "筛选 NS 记录。",
      "try_commands": [
        "grep \"NS\" dns/zones/lab.local.zone"
      ],
      "success_criteria": "输出 ns.lab.local。",
      "coach_focus": "解释 NS 记录指向域名服务器。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "grep \"NS\" dns/zones/lab.local.zone"
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "查看 A 记录",
      "goal": "定位域名到 IP 的映射。",
      "instructions": "筛选 A 记录。",
      "try_commands": [
        "grep \" IN A \" dns/zones/lab.local.zone"
      ],
      "success_criteria": "输出 ns 和 www 的地址。",
      "coach_focus": "说明 A 记录用于 IPv4 解析。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "grep \" IN A \" dns/zones/lab.local.zone"
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "新增主机记录",
      "goal": "练习添加一条 A 记录。",
      "instructions": "向区域文件追加 app 记录。",
      "try_commands": [
        "echo \"app IN A 10.10.10.30\" >> dns/zones/lab.local.zone"
      ],
      "success_criteria": "zone 文件包含 app IN A。",
      "coach_focus": "强调追加记录时保持格式一致。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "echo \"app IN A 10.10.10.30\" >> dns/zones/lab.local.zone"
            ]
          },
          {
            "type": "file_contains",
            "path": "dns/zones/lab.local.zone",
            "text": "app IN A"
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "编写 DNS 配置摘要",
      "goal": "总结 DNS 配置要点。",
      "instructions": "写入 DNS 配置摘要。",
      "try_commands": [
        "echo \"dns zone lab.local has A records\" > dns/report/dns-summary.txt"
      ],
      "success_criteria": "dns-summary.txt 包含 lab.local。",
      "coach_focus": "帮助学生建立 zone、NS、A 记录关联。",
      "verification": {
        "mode": "all",
        "checks": [
          {
            "type": "command_match",
            "commands": [
              "echo \"dns zone lab.local has A records\" > dns/report/dns-summary.txt"
            ]
          },
          {
            "type": "file_contains",
            "path": "dns/report/dns-summary.txt",
            "text": "lab.local"
          }
        ]
      }
    }
  ],
  "container_spec": {
    "base_image": "openeuler/openeuler:22.03-lts-sp3",
    "packages": [],
    "pip_packages": [],
    "npm_packages": [],
    "student_dirs": [
      "dns/zones",
      "dns/report"
    ],
    "student_files": [
      {
        "path": "dns/named.conf.sample",
        "content": "options { directory \"/home/student/dns/zones\"; };\nzone \"lab.local\" IN { type master; file \"lab.local.zone\"; };\n"
      },
      {
        "path": "dns/zones/lab.local.zone.sample",
        "content": "$TTL 3600\n@ IN SOA ns.lab.local. admin.lab.local. (1 1H 15M 1W 1D)\n@ IN NS ns.lab.local.\nns IN A 10.10.10.10\nwww IN A 10.10.10.20\n"
      }
    ],
    "sources": {
      "openeuler_mirror": "https://repo.huaweicloud.com/openeuler",
      "pip_index_url": "https://pypi.tuna.tsinghua.edu.cn/simple",
      "npm_registry": "https://registry.npmmirror.com"
    }
  }
}
